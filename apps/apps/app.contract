shape Draft
  body: string

component Paperstack
  resource kept = loadDraft() as shape Draft else empty(body="")
  mutation written as shape Draft
  state body = ""
  state edited = false
  state reading = false
  derive current = edited ? body : kept.body
  action edit(value)
    body = value
    edited = true
    send written = saveDraft(value)
  action toggle
    reading = not reading
  action bold
    format("draft", "bold")
  action heading
    format("draft", "heading", "2")
  view
    main testId="root" height="100%" width="100%" background-color="#f5f1e7"
      scroll height="100%" width="100%"
        column padding=24 gap=18
          text "Paperstack" role="heading" aria-level=1 font-family="serif" font-size=42 color="#262d3c"
          row gap=12 flex-wrap="wrap"
            button press=toggle testId="mode"
              text (reading ? "Edit draft" : "Preview draft")
            if not reading
              button press=heading aria-label="Format heading" testId="heading"
                text "Heading"
              button press=bold aria-label="Format bold" testId="bold"
                text "Bold"
          if reading
            text current markup="markdown" font-family="serif" font-size=20 color="#262d3c" testId="reader"
          else
            textarea id="draft" markup="markdown" value=current input=edit testId="editor" aria-label="Markdown draft" width="100%" height=380 padding=16 background-color="#fffdf6" color="#262d3c" font-size=18
          if failed(written)
            text "Your changes could not be saved on this device." color="#9e3420"
